# SemanticBehavior: resolve the address for a CEP.

fetch "https://www.qualocep.com/busca-cep/18464142"

street = get text from <span[itemprop="streetAddress"]>
neighborhood = get text from <body > div.container > div.row.table-responsive > table > tbody > tr:nth-child(2) > td:nth-child(3)>
locality = get text from <span[itemprop=addressLocality]>

return { street, neighborhood, locality }
